<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- شبكات/تنزيلات -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Services (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:targetApi="34" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:targetApi="34" />

    <!-- الإشعارات (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:targetApi="33" />

    <!-- اختيارية -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- إزالة أذونات الإعلانات إن أتت ترانزيتيفاً -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/icon4"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon4"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuranKarim"
        android:localeConfig="@xml/locales_config">

        <meta-data
            android:name="androidx.appcompat.app.locale_config"
            android:resource="@xml/locales_config" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- Launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.QuranKarim">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- شاشة اختيار اللغة -->
        <activity
            android:name=".onboarding.LanguageSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.Light.NoActionBar" />
        <receiver
            android:name=".UpdateNotifReceiver"
            android:exported="false" />

        <!-- إشعارات التشغيل/الإيقاف -->
        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="al_quran2.NOTIF_TOGGLE" />
                <action android:name="al_quran2.NOTIF_STOP" />
            </intent-filter>
        </receiver>

        <!-- صفحة المصحف -->
        <activity
            android:name=".QuranPageActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".search.SearchActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value=".MainActivity" />
        </activity>

        <!-- ✅ خدمة تنزيل التلاوات/الملفات (Foreground Data Sync) -->
        <service
            android:name=".download.PagesDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ✅ خدمة تشغيل الصوت (Foreground Media Playback) -->
        <!-- خدمة WorkManager الأمامية (لازم نستبدل تعريفها الافتراضي) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaPlayback"
            tools:targetApi="34"
            tools:node="replace" />

    </application>
</manifest>
