<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- نص التبويب العادي -->
    <style name="TabText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- نص التبويب عريض (Bold) -->
    <style name="TabText.Bold" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- لو تريد لونًا مختلفًا للحالة المحددة -->
    <style name="TabText.Selected" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#2B2417</item> <!-- نفس اللون الذي تستخدمه للتبويب المحدد -->
    </style>

</resources>
