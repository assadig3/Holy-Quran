<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- توهج أزرق سماوي ناعم -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="12dp" />
            <stroke android:width="6dp" android:color="#3380D8FF" /> <!-- أزرق فاتح شفاف -->
        </shape>
    </item>

    <!-- التدرّج الليلي -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#002B4A"
                android:centerColor="#00385F"
                android:endColor="#00426E"
                android:type="linear" />

            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
            <padding android:left="8dp" android:top="6dp" android:right="8dp" android:bottom="6dp" />
        </shape>
    </item>

</layer-list>
