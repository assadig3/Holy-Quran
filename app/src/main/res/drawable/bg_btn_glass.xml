<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF"/> <!-- أبيض 15% -->
            <corners android:radius="14dp"/>
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="0dp"/>
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF"/> <!-- أبيض 25% -->
        </shape>
    </item>
</ripple>
