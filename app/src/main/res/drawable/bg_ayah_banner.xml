<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- توهج ذهبي ناعم خلف الشريط -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="6dp" android:color="#33FFD54F" /> <!-- توهج خفيف -->
        </shape>
    </item>

    <!-- التدرّج الذهبي الأساسي -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#FFF8E1"
                android:centerColor="#FFECB3"
                android:endColor="#FFE082"
                android:type="linear" />

            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#664D3B00" />
            <padding android:left="8dp" android:top="6dp" android:right="8dp" android:bottom="6dp" />
        </shape>
    </item>

</layer-list>
