<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- زوايا دائرية -->
    <corners android:radius="12dp" />

    <!-- لون ديناميكي: غامق في الليل، فاتح في النهار -->
    <solid android:color="?attr/colorPrimary" />

    <!-- حدود خفيفة -->
    <stroke
        android:width="1dp"
        android:color="@color/overlay_panel_stroke" />

    <!-- ظل داخلي بسيط -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>
