<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="1.5dp"
    app:cardBackgroundColor="@color/surahCardBackground"
    app:strokeColor="@color/surahCardBorder"
    app:strokeWidth="0.8dp"
    app:rippleColor="@color/surahRipple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- رقم السورة داخل دائرة -->
        <TextView
            android:id="@+id/surahNumber"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/onSurahBadge"
            android:background="@drawable/bg_surah_badge"
            android:importantForAccessibility="no"
            tools:text="١" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/surahTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/surahTitleText"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="الفاتحة" />

            <TextView
                android:id="@+id/surahDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/surahSubText"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="مكية • 7 آيات • صفحة 1" />
        </LinearLayout>

        <!-- أيقونة جانبية -->
        <ImageView
            android:id="@+id/surahTrailingIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/surahIconTint"
            android:contentDescription="@null" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
