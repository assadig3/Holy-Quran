<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ayahBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="6dp"
    android:minHeight="44dp"
    android:orientation="vertical"
    android:background="@drawable/bg_ayah_banner"
    android:elevation="12dp"
    android:paddingHorizontal="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layoutDirection="rtl"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- الصف الرئيسي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- أيقونة السورة: بدون tint حتى لا تختفي في النهاري -->
        <ImageView
            android:id="@+id/surahIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/icon"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/surahName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textSize="13sp"
            android:textColor="@color/ayah_banner_on"
            tools:text="البقرة" />

        <TextView
            android:id="@+id/ayahNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="12sp"
            android:textColor="@color/ayah_banner_on"
            tools:text="آية 7" />

        <TextView
            android:id="@+id/ayahText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:textColor="@color/ayah_banner_on"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            tools:text="﴿إِنَّ الَّذِينَ كَفَرُوا سَوَاءٌ عَلَيْهِم…﴾" />

        <ImageButton
            android:id="@+id/btnCloseBanner"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_button_tonal"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/close"
            android:saveEnabled="false"
            android:src="@drawable/ic_close"
            android:tint="@color/ayah_banner_on" />
    </LinearLayout>

    <!-- سطر معلومات الصفحة -->
    <TextView
        android:id="@+id/pageInfoInline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="1dp"
        android:textSize="12sp"
        android:textColor="@color/ayah_banner_on"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        tools:text="الصفحة 3 • الجزء 1 • سورة البقرة" />
</LinearLayout>
