<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="1.5dp"
    app:cardBackgroundColor="@color/juzCardBackground"
    app:strokeColor="@color/juzCardBorder"
    app:strokeWidth="0.8dp"
    app:rippleColor="@color/juzRipple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <!-- رقم الجزء -->
        <TextView
            android:id="@+id/juzNumberText"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_juz_badge"
            android:text="١"
            android:textColor="@color/onJuzBadge"
            android:textStyle="bold"
            android:textSize="13sp"
            android:importantForAccessibility="no" />

        <!-- اسم الجزء والتفاصيل -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/juzNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الجزء الأول"
                android:textColor="@color/juzTitleText"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/juzHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="من سورة الفاتحة إلى سورة البقرة"
                android:textColor="@color/juzSubText"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- السهم -->
        <ImageView
            android:id="@+id/juzChevron"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/juzIconTint"
            android:contentDescription="@null" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
