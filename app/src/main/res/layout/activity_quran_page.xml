<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quran_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:keepScreenOn="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="ExtraText">

    <!-- الشريط العلوي -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_gravity="top"
        android:elevation="8dp"
        android:translationZ="8dp"
        app:backgroundTint="?attr/colorPrimary"
        app:title="القرآن الكريم"
        app:contentInsetStartWithNavigation="0dp"
        app:titleTextAppearance="@style/ToolbarTitleLarge"
        app:titleCentered="false"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents"
        app:titleTextColor="?attr/colorOnPrimary"
        app:navigationIconTint="?attr/colorOnPrimary" />

    <!-- صفحات المصحف -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pageViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="75dp"
        android:overScrollMode="never"
        android:background="@color/quran_page_bg"
        android:clipToPadding="false"
        android:clipChildren="false" />

    <!-- الأوفرلايز السفلية -->
    <LinearLayout
        android:id="@+id/bottomOverlays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- شريط خيارات الآية -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ayahOptionsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@android:color/transparent"
            app:cardBackgroundColor="@color/overlay_card_bg_66">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/transparent"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/ayahButtonsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <ImageButton
                        android:id="@+id/btnCloseOptions"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_button_transparent"
                        android:contentDescription="@string/close"
                        android:padding="6dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/sky_blue_dark" />

                    <Space android:layout_width="6dp" android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/btnTafsirMenu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_transparent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/tafsir"
                        android:textColor="@color/sky_blue_dark"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnDownloadTafsir"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_transparent"
                        android:contentDescription="@string/download"
                        android:padding="6dp"
                        android:src="@drawable/ic_download"
                        app:tint="@color/sky_blue_dark" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnPlayAyah"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_transparent"
                        android:contentDescription="@string/play_ayah"
                        android:padding="6dp"
                        android:src="@drawable/ic_play"
                        app:tint="@color/sky_blue_dark" />

                    <ImageButton
                        android:id="@+id/btnCopyAyah"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_button_transparent"
                        android:contentDescription="@string/copy"
                        android:padding="6dp"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/sky_blue_dark" />

                    <ImageButton
                        android:id="@+id/btnShareAyah"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_button_transparent"
                        android:contentDescription="@string/share"
                        android:padding="6dp"
                        android:src="@drawable/ic_share"
                        app:tint="@color/sky_blue_dark" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ayahPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textColor="@color/sky_blue_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- بطاقات التحكم بالصوت -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/audioControlsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@android:color/transparent"
            app:cardBackgroundColor="@color/overlay_card_bg_66">

            <LinearLayout
                android:id="@+id/audioControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                android:background="@android:color/transparent">

                <TextView
                    android:id="@+id/btnQari"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_button_transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/reader"
                    android:textColor="@color/sky_blue_dark"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnRepeat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_button_transparent"
                    android:contentDescription="@string/repeat_off"
                    android:padding="8dp"
                    android:src="@drawable/ic_repeat"
                    app:tint="@color/sky_blue_dark" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_transparent"
                    android:contentDescription="@string/play_pause"
                    android:padding="8dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/sky_blue_dark" />

                <ImageButton
                    android:id="@+id/audio_download"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_transparent"
                    android:contentDescription="@string/download"
                    android:padding="8dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/sky_blue_dark" />

                <ImageButton
                    android:id="@+id/btnCloseAudioBar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_transparent"
                    android:contentDescription="@string/close"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/sky_blue_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</FrameLayout>
